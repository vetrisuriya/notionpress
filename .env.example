# ---- Web app (Vercel environment variables) ----
APP_URL=https://notionpress-np.vercel.app
NOTIONSYNC_APP_NAME="NotionPress"

# Free Postgres (for example Neon or Supabase) connection string
DATABASE_URL=

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Any random string of 32+ characters
SESSION_SECRET=

# Notion public integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional. Defaults to APP_URL + /api/auth/notion/callback
NOTION_REDIRECT_URI=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the .pem contents (line breaks or \n both work)
GITHUB_APP_PRIVATE_KEY=

# Optional: start the sync workflow right away instead of waiting up to ~10 minutes.
# Token: fine-grained personal access token with "Actions: Read and write" on the app repository.
DISPATCH_TOKEN=
DISPATCH_REPO=your-name/repo-sync-for-notion
DISPATCH_REF=main
# Required by the daily Vercel cron route (any random string)
CRON_SECRET=

# ---- GitHub Actions secrets (same repository, Settings > Secrets > Actions) ----
# DATABASE_URL, TOKEN_ENCRYPTION_KEY (same values as above)
# GH_APP_ID (= GITHUB_APP_ID), GH_APP_PRIVATE_KEY (= GITHUB_APP_PRIVATE_KEY)
# Note: names starting with GITHUB_ are reserved for secrets, hence the GH_ prefix.
